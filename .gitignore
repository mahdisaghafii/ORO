# Committed on purpose, so not ignored: .claude/skills/, .claude/agents/,
# .claude/settings.json, .claude/project.toml and CLAUDE.md.

# Worktrees of a multi-repo Project live under <root>/wt/ (design doc 3).
/wt/

# Environment files and secrets: never committed (.env, .env.*, and *.env such as prod.env).
# Example-style names stay (the names project.py check does not count as env files). Git
# matches these case-sensitively unless core.ignorecase is on.
.env
.env.*
*.env
!.env.example
!.env.sample
!.env.template
!.env.dist
!.env.*.example
!.env.*.sample
!.env.*.template
